NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4110
WEB_ORIGIN=http://127.0.0.1:5175
VITE_API_URL=http://127.0.0.1:4110
VITE_BACKEND_URL=http://127.0.0.1:4110
VITE_WS_URL=ws://127.0.0.1:4110/ws
DATABASE_URL=postgresql://sugarcane:sugarcane@127.0.0.1:5432/sugarcane
AI_DATABASE_URL=postgresql://sugarcane:sugarcane@127.0.0.1:5432/sugarcane_ai
DATABASE_REQUIRED=true
AI_SERVICE_URL=http://127.0.0.1:8010
# Browser AI requests go through /api/ai. Both services must share JWT_SECRET.
# AI_SERVICE_TOKEN can optionally override the derived internal service token.
# REQUIRED_CAMERA_IDS=2

# Master Platform Bootstrap
APP_DEVELOPER_USER=developer
APP_DEVELOPER_PASSWORD=ganti_dengan_password_developer
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=ganti_dengan_password_admin
JWT_SECRET=ganti_dengan_jwt_secret_yang_panjang_dan_acak

# PT Trangkil (Pati) Accounts
USER_TRANGKIL_ADMIN=admin_trangkil
PASSWORD_TRANGKIL_ADMIN=ganti_dengan_password_admin_trangkil
USER_TRANGKIL_OPERATOR=operator_trangkil
PASSWORD_TRANGKIL_OPERATOR=ganti_dengan_password_operator_trangkil

# PT Kebon Agung (Malang) Accounts
USER_KEBONAGUNG_ADMIN=admin_kebonagung
PASSWORD_KEBONAGUNG_ADMIN=ganti_dengan_password_admin_kebonagung
USER_KEBONAGUNG_OPERATOR=operator_kebonagung
PASSWORD_KEBONAGUNG_OPERATOR=ganti_dengan_password_operator_kebonagung

# 2FA PIN (Optional override)
ADMIN_2FA_PIN=

# CCTV RTSP credentials are configured locally; never commit actual URLs.
CCTV_KEBONAGUNG_RTSP_URL=
CCTV_TRANGKIL_RTSP_URL=
