{
  "name": "sugarcane-platform-malang",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev-malang.mjs",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
    "dev:web": "node scripts/dev-malang.mjs",
    "dev:api": "npm run dev -w @sugarcane/api",
    "dev:frontend": "npm run dev -w @sugarcane/web",
    "dev:ai": "node scripts/run-ai.mjs",
    "dev:desktop": "npm run dev -w @sugarcane/desktop",
    "dev:dekstop": "npm run dev:desktop",
    "build": "npm run build -w @sugarcane/api && npm run build -w @sugarcane/web && npm run build -w @sugarcane/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:ready": "node scripts/check-malang.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @sugarcane/api",
    "start:malang": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-malang.ps1",
    "stop:malang": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-malang.ps1",
    "db:setup": "node scripts/setup-malang-db.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
